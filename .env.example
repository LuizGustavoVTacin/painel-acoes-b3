# Copie para .env e preencha. O .env nunca vai para o git.
# O app não usa nenhuma chave de API: todas as fontes são gratuitas e sem cadastro.
PORT=3000

# Arquivo do banco SQLite (absoluto ou relativo à pasta do projeto). Padrão: dados.db
DB_ARQUIVO=

# 1 = o iniciar.bat não abre o navegador (o dashboard sobe do mesmo jeito).
SEM_NAVEGADOR=
